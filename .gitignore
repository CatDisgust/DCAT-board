# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local AI assistant instructions
AGENTS.md
CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# iOS local configuration and Xcode user state
/ios/DaymarkHealth/Config/Local.xcconfig
/ios/DaymarkHealth/*.xcodeproj/xcuserdata/
/ios/DaymarkHealth/*.xcodeproj/project.xcworkspace/xcuserdata/
/ios/DaymarkHealth/DerivedData/
